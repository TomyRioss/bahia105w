# PocketBase (self-hosted en VPS) — SIEMPRE https en producción (reverse proxy
# con TLS). Con http, passwords y el token superuser viajan en texto plano.
POCKETBASE_URL=https://pb.tudominio.com
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# NextAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (notificacion de pedido nuevo al vendedor)
RESEND_API_KEY=
VENDOR_EMAIL=
EMAIL_FROM=
